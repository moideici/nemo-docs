{
  // Site de documentation : 100 % statique (dossier site/), servi par Cloudflare.
  // Racine (/) = synthèse de toutes les docs ; /nemo/ = documentation interactive de Nemo.
  // Aucun code de Worker : seulement des assets statiques.
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "nemo-docs",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./site",
    "not_found_handling": "404-page"
  },

  // DOMAINE : docs.moideici.tech (racine = synthèse, /nemo/ = documentation de Nemo).
  // `nemo.moideici.tech` appartient DÉJÀ au Worker nemo-https (Custom Domain) : ne pas le réutiliser ici,
  // sous peine de remplacer le serveur de Nemo par cette documentation.
  "routes": [{ "pattern": "docs.moideici.tech", "custom_domain": true }]
}
